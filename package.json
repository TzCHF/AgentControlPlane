{
  "name": "agent-control-plane",
  "version": "0.3.0",
  "private": true,
  "license": "Apache-2.0",
  "description": "A local, model-agnostic control plane that lets web AI dispatch compact briefs to interchangeable engineering executors.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node --test",
    "check": "node --check src/server.js",
    "doctor": "node scripts/doctor.js",
    "smoke": "node scripts/smoke.js",
    "smoke:budget": "node scripts/smoke-budget.js",
    "benchmark:report": "node scripts/benchmark-report.js",
    "verify:audit": "node scripts/verify-audit.js",
    "sandbox:setup": "node scripts/setup-windows-sandbox.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.17.0",
    "zod": "^3.25.0"
  }
}
