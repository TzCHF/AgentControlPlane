{
  "server": {
    "host": "127.0.0.1",
    "port": 4318,
    "allowedOrigins": [],
    "maxMcpSessions": 32,
    "mcpSessionIdleMinutes": 30
  },
  "workspaceRoots": [],
  "companion": {
    "enabled": true,
    "pairingTtlMinutes": 10,
    "maxClients": 32,
    "maxPending": 16
  },
  "codex": {
    "command": "codex",
    "defaultModel": null,
    "approvalPolicy": "never",
    "sandbox": "workspace-write",
    "networkAccess": false,
    "disabledFeatures": [
      "apps",
      "plugins",
      "browser_use",
      "computer_use",
      "image_generation"
    ]
  },
  "executor": {
    "provider": "auto",
    "routing": {
      "order": [
        "opencode",
        "codex",
        "claude",
        "openai-compatible",
        "deepseek"
      ]
    },
    "openaiCompat": {
      "baseUrl": "http://127.0.0.1:10100/v1",
      "apiKey": null,
      "model": "deepseek/deepseek-v4-pro",
      "protocol": "responses",
      "models": ["deepseek/deepseek-v4-pro", "deepseek-v4-pro"]
    },
    "deepseek": {
      "baseUrl": "https://api.deepseek.com/v1",
      "apiKeyEnv": "DEEPSEEK_API_KEY",
      "model": "deepseek-chat",
      "protocol": "chat",
      "models": ["deepseek-chat", "deepseek-reasoner"]
    },
    "claude": {
      "command": "claude",
      "model": null,
      "allowedTools": ["Read", "Write", "Edit", "Bash"],
      "permissionMode": "acceptEdits",
      "maxTurns": 30
    },
    "opencode": {
      "command": "opencode",
      "model": null,
      "agent": null,
      "autoApprove": true
    }
  },
  "profiles": {
    "economy": {
      "model": "gpt-5.6-luna",
      "effort": "low",
      "maxSubagents": 0,
      "tokenBudget": 30000,
      "summary": "concise"
    },
    "balanced": {
      "model": "gpt-5.6-terra",
      "effort": "high",
      "maxSubagents": 2,
      "tokenBudget": 90000,
      "summary": "concise"
    },
    "deep": {
      "model": "gpt-5.6-sol",
      "effort": "ultra",
      "maxSubagents": 4,
      "tokenBudget": 220000,
      "summary": "detailed"
    }
  },
  "limits": {
    "maxBriefCharacters": 24000,
    "maxConcurrentTasks": 2,
    "maxQueuedTasks": 100,
    "maxTokenBudget": 250000,
    "maxStoredTasks": 2000,
    "maxStoredEventsPerTask": 500,
    "maxAuditBytes": 10485760,
    "maxTaskRuntimeMinutes": 240,
    "tokenUsagePollIntervalMs": 1000,
    "rateLimit": {
      "enabled": true,
      "windowMs": 60000,
      "max": 120
    }
  },
  "audit": {
    "integrityKey": null
  }
}
